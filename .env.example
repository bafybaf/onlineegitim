# Coolify → Environment Variables. Üretimde güçlü şifre kullanın.
DB_PASS=degistir-bu-sifreyi
DB_ROOT_PASS=degistir-root-sifreyi

# İlk yönetici (Docker açılınca otomatik oluşur). Şifre en az 10 karakter.
ADMIN_EMAIL=admin@onlineilahiyat.com
ADMIN_PASSWORD=degistir-admin-sifreyi
ADMIN_NAME=Yönetici

# Site kök domainde: boş bırakın. Yerel XAMPP: /online-ilahiyat
BASE_URL=

# MediaMTX WebRTC ICE adresi (VPS güvenlik duvarında 8189/udp açık olsun)
LIVE_HOST=onlineilahiyat.com

# Boş bırakın: izleme aynı siteden /mtx-hls ve /mtx-whep ile gider (önerilen).
# Özel CDN kullanıyorsanız dolu tutun.
LIVE_HLS_BASE=
LIVE_WHEP_BASE=

# iyzico anahtarları Admin → Ödeme panelinden girilir (iyzico_api_key / iyzico_secret_key).
